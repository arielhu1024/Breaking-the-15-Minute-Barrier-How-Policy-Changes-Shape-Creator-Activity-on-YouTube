        "import matplotlib.pyplot as plt\n",
        "\n",
        "def plot_event_study(event_results_df, title, ylabel):\n",
        "    fig, ax = plt.subplots(figsize=(10, 5))\n",
        "    ax.axhline(0, color=\"black\", linewidth=1)\n",
        "    ax.axvline(-0.5, color=\"gray\", linestyle=\"--\", linewidth=1)\n",
        "    ax.errorbar(\n",
        "        event_results_df[\"event_time\"],\n",
        "        event_results_df[\"coef\"],\n",
        "        yerr=1.96 * event_results_df[\"se\"],\n",
        "        fmt=\"o-\",\n",
        "        capsize=3\n",
        "    )\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Months relative to December 2010 policy\")\n",
        "    ax.set_ylabel(ylabel)\n",
        "    ax.grid(True, alpha=0.25)\n",
        "    plt.show()\n",
        "\n",
        "plot_event_study(\n",
        "    event_ols_df,\n",
        "    \"Event Study: Eligible Creator Effect on log1p Monthly Views\",\n",
        "    \"Coefficient relative to November 2010\"\n",
