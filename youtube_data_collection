        "def fit_ols_did(df, outcome):\n",
        "    formula = f\"{outcome} ~ did_eligible + C(actual_channel_id) + C(year_month)\"\n",
        "    return smf.ols(formula, data=df).fit(\n",
        "        cov_type=\"cluster\",\n",
        "        cov_kwds={\"groups\": df[\"actual_channel_id\"]}\n",
        "    )\n",
        "\n",
        "def fit_poisson_did(df, outcome):\n",
        "    formula = f\"{outcome} ~ did_eligible + C(actual_channel_id) + C(year_month)\"\n",
        "    return smf.glm(\n",
        "        formula=formula,\n",
        "        data=df,\n",
        "        family=sm.families.Poisson()\n",
        "    ).fit(\n",
        "        cov_type=\"cluster\",\n",
        "        cov_kwds={\"groups\": df[\"actual_channel_id\"]},\n",
        "        maxiter=200\n",
        "    )\n",
        "\n",
        "def fit_negbin_did(df, outcome):\n",
        "    \"\"\"Estimate NB2 when possible; fall back to GLM NB if fixed effects are too demanding.\"\"\"\n",
        "    formula = f\"{outcome} ~ did_eligible + C(actual_channel_id) + C(year_month)\"\n",
        "    try:\n",
        "        return smf.negativebinomial(formula=formula, data=df).fit(\n",
        "            disp=False,\n",
        "            maxiter=200,\n",
        "            cov_type=\"cluster\",\n",
        "            cov_kwds={\"groups\": df[\"actual_channel_id\"]}\n",
        "        )\n",
        "    except Exception as exc:\n",
        "        print(f\"NB2 MLE did not converge for {outcome}; using GLM NegativeBinomial fallback. Reason: {exc}\")\n",
        "        return smf.glm(\n",
        "            formula=formula,\n",
        "            data=df,\n",
        "            family=sm.families.NegativeBinomial(alpha=1.0)\n",
        "        ).fit(\n",
        "            cov_type=\"cluster\",\n",
        "            cov_kwds={\"groups\": df[\"actual_channel_id\"]},\n",
        "            maxiter=200\n",
        "        )\n",
        "\n",
        "def did_result_row(model_name, outcome, result):\n",
        "    coef = result.params.get(\"did_eligible\", np.nan)\n",
        "    se = result.bse.get(\"did_eligible\", np.nan)\n",
        "    pval = result.pvalues.get(\"did_eligible\", np.nan)\n",
        "    irr = np.exp(coef) if model_name in {\"Poisson\", \"Negative Binomial\"} and pd.notna(coef) else np.nan\n",
        "    return {\n",
        "        \"model\": model_name,\n",
        "        \"outcome\": outcome,\n",
        "        \"did_coef\": coef,\n",
        "        \"cluster_se\": se,\n",
        "        \"p_value\": pval,\n",
        "        \"incidence_rate_ratio\": irr,\n",
        "        \"nobs\": int(result.nobs),\n",
        "    }\n"
      ]
