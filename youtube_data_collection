        "EVENT_WINDOW = range(-11, 13)  # Jan 2010 through Dec 2011 around Dec 2010 policy\n",
        "EVENT_REFERENCE = -1\n",
        "\n",
        "event_df = model_df.copy()\n",
        "for k in EVENT_WINDOW:\n",
        "    if k == EVENT_REFERENCE:\n",
        "        continue\n",
        "    suffix = str(k).replace(\"-\", \"m\").replace(\"+\", \"p\")\n",
        "    col = f\"event_{suffix}\"\n",
        "    event_df[col] = ((event_df[\"eligible_creator\"] == 1) & (event_df[\"event_time_policy_months\"] == k)).astype(int)\n",
        "\n",
        "event_terms = \" + \".join(\n",
        "    f\"event_{str(k).replace('-', 'm').replace('+', 'p')}\"\n",
        "    for k in EVENT_WINDOW if k != EVENT_REFERENCE\n",
        ")\n",
        "\n",
        "def fit_event_study(df, outcome, family=\"ols\"):\n",
        "    if family == \"ols\":\n",
        "        formula = f\"log1p_{outcome} ~ {event_terms} + C(actual_channel_id) + C(year_month)\"\n",
        "        return smf.ols(formula, data=df).fit(\n",
        "            cov_type=\"cluster\",\n",
        "            cov_kwds={\"groups\": df[\"actual_channel_id\"]}\n",
        "        )\n",
        "    if family == \"poisson\":\n",
        "        formula = f\"{outcome} ~ {event_terms} + C(actual_channel_id) + C(year_month)\"\n",
        "        return smf.glm(formula=formula, data=df, family=sm.families.Poisson()).fit(\n",
        "            cov_type=\"cluster\",\n",
        "            cov_kwds={\"groups\": df[\"actual_channel_id\"]},\n",
        "            maxiter=200\n",
        "        )\n",
        "    raise ValueError(\"family must be 'ols' or 'poisson'\")\n",
        "\n",
        "def tidy_event_study(result):\n",
        "    rows = []\n",
        "    for k in EVENT_WINDOW:\n",
        "        if k == EVENT_REFERENCE:\n",
        "            rows.append({\"event_time\": k, \"coef\": 0.0, \"se\": 0.0, \"reference\": True})\n",
        "            continue\n",
        "        name = f\"event_{str(k).replace('-', 'm').replace('+', 'p')}\"\n",
        "        rows.append({\n",
        "            \"event_time\": k,\n",
        "            \"coef\": result.params.get(name, np.nan),\n",
        "            \"se\": result.bse.get(name, np.nan),\n",
        "            \"reference\": False,\n",
        "        })\n",
        "    out = pd.DataFrame(rows)\n",
        "    out[\"ci_low\"] = out[\"coef\"] - 1.96 * out[\"se\"]\n",
        "    out[\"ci_high\"] = out[\"coef\"] + 1.96 * out[\"se\"]\n",
        "    return out\n",
        "\n",
        "event_outcome = \"monthly_views_sum_current\"\n",
        "event_ols = fit_event_study(event_df, event_outcome, family=\"ols\")\n",
        "event_poisson = fit_event_study(event_df, event_outcome, family=\"poisson\")\n",
        "\n",
        "event_ols_df = tidy_event_study(event_ols)\n",
        "event_poisson_df = tidy_event_study(event_poisson)\n",
        "event_ols_df\n"
      ]
